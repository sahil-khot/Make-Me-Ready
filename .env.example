# ==============================================================================
# MAKE ME READY - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development or enter these variables in
# your Vercel Project Settings (Settings -> Environment Variables).

# ------------------------------------------------------------------------------
# 1. Database Connection (REQUIRED)
# ------------------------------------------------------------------------------
# For Local Development:
MONGODB_URI=mongodb://127.0.0.1:27017/make_me_ready
#
# For Vercel Production (Use your MongoDB Atlas cluster URI):
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/make_me_ready?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Authentication Security (REQUIRED)
# ------------------------------------------------------------------------------
# A secure random secret string used to sign JWT tokens (minimum 32 characters)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# ------------------------------------------------------------------------------
# 3. Google Gemini API (For AI Fashion Assistant)
# ------------------------------------------------------------------------------
# Get your free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
VITE_GEMINI_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. Server & Client Origins
# ------------------------------------------------------------------------------
# Local development server port (ignored by Vercel serverless)
PORT=3001

# Allowed client origins for CORS (comma-separated or *).
# On Vercel, requests from .vercel.app domains are automatically allowed.
CLIENT_ORIGIN=http://localhost:5173

# Optional: Frontend API Base URL (leave empty or / on Vercel for same-domain routing)
VITE_API_URL=
