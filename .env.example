# Make Me Ready Environment Configuration
# Local MongoDB example: mongodb://127.0.0.1:27017/make_me_ready
# MongoDB Atlas example: mongodb+srv://<db_user>:<db_password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/make_me_ready

# Secret key for JWT signing (minimum 32 characters recommended)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Backend API server port
PORT=3001

# Allowed client origin for CORS
CLIENT_ORIGIN=http://localhost:5173
